# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/client-hunter

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# ── AI ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── Scraping ──────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx

# ── Email (Resend) ────────────────────────────────────────
# Get key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Abyte Hunt <you@yourdomain.com>
DIGEST_EMAIL=you@yourdomain.com

# ── WhatsApp (Meta Cloud API) ─────────────────────────────
# Get from: https://developers.facebook.com/apps/
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ── Email Enrichment (Hunter.io) ──────────────────────────
# Get from: https://hunter.io/api-keys
HUNTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Slack Notifications ───────────────────────────────────
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── URLs ─────────────────────────────────────────────────
# Production: set these to your deployed URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
